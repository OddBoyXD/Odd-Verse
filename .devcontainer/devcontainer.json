{
  "name": "Odd Verse Flutter Environment",
  "image": "ghcr.io/cirruslabs/flutter:3.24.3",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installJdk": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  },
  "postCreateCommand": "flutter doctor && flutter pub get"
}
